<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Sample Webpage</title>
</head>
<body>

    <!-- Main Heading -->
    <h1>Welcome to My Website</h1>

    <!-- A simple paragraph -->
    <p>This is a basic paragraph explaining what this page is about. HTML structures the content of the web.</p>

    <!-- An example link pointing to W3Schools -->
    <p>Learn more by visiting <a href="https://www.w3schools.com" target="_blank">W3Schools</a>.</p>

    <!-- An unordered list -->
    <h2>My Favorite Things</h2>
    <ul>
        <li>Coding</li>
        <li>Designing websites</li>
        <li>Learning new things</li>
    </ul>

    <!-- A simple interactive button -->
    <button type="button" onclick="alert('Hello World!')">Click Me!</button>

</body>
</html>

